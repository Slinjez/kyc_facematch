# Copy to .env. FACE_SERVICE_API_KEY must equal FACE_SERVICE_API_KEY in kyc_v02/.env.
FACE_SERVICE_API_KEY=
# Keep on 127.0.0.1 - only the KYC admin app on this server should reach it.
FACE_SERVICE_HOST=127.0.0.1
FACE_SERVICE_PORT=8100
FACE_SERVICE_MAX_FILE_MB=15
FACE_SERVICE_MAX_REFERENCES=10
FACE_SERVICE_BUSY_WAIT_SECONDS=45
# Cosine-similarity band cut-offs (calibrate on our own selfie/ID pairs).
FACE_BAND_STRONG=0.45
FACE_BAND_POSSIBLE=0.35
FACE_BAND_WEAK=0.25
